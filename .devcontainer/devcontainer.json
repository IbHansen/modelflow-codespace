{
  "name": "ModelFlow (Miniforge)",
  "build": {
    "dockerfile": "Dockerfile",
    // repo root, so the Dockerfile can COPY environment.yml
    "context": ".."
  },
  "remoteUser": "vscode",

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-toolsai.jupyter"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/opt/conda/envs/modelflow/bin/python",
        "python.condaPath": "/opt/conda/bin/conda"
      }
    },
    "codespaces": {
      "openFiles": ["README.md"]
    }
  },

  // 8888 is not listed: it is forwarded (and opened) when Jupyter starts listening, not before
  "forwardPorts": [5001, 8050],
  "portsAttributes": {
    "8888": { "label": "Jupyter Notebook", "onAutoForward": "openBrowser" },
    "5001": { "label": "ModelFlow .dash()" },
    "8050": { "label": "Dash" }
  },

  // Fails the creation log loudly if modelflow does not import
  "postCreateCommand": "python .devcontainer/smoke_test.py",

  // Start Jupyter Notebook, without a token, in its own terminal each time VS Code connects.
  // port_retries=0: a second connection does not start a second server on 8889.
  // The forwarded port is private (only reachable with your GitHub login) - never make port 8888 public.
  "postAttachCommand": {
    "jupyter": "jupyter notebook --no-browser --ServerApp.root_dir=${containerWorkspaceFolder} --ServerApp.port_retries=0 --IdentityProvider.token=''"
  }
}
