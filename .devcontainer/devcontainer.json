{
  "name": "ModelFlow (Miniforge)",
  "build": {
    "dockerfile": "Dockerfile",
    // repo root, so the Dockerfile can COPY environment.yml
    "context": ".."
  },
  "remoteUser": "vscode",

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-toolsai.jupyter"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/opt/conda/envs/modelflow/bin/python",
        "python.condaPath": "/opt/conda/bin/conda"
      }
    },
    "codespaces": {
      "openFiles": ["README.md"]
    }
  },

  "forwardPorts": [8888, 5001, 8050],
  "portsAttributes": {
    "8888": { "label": "Jupyter Notebook", "onAutoForward": "openBrowser" },
    "5001": { "label": "ModelFlow .dash()" },
    "8050": { "label": "Dash" }
  },

  // Fails the creation log loudly if modelflow does not import
  "postCreateCommand": "python .devcontainer/smoke_test.py",

  // Start Jupyter Notebook every time the codespace starts, without a token.
  // The forwarded port is private (only reachable with your GitHub login) - never make port 8888 public.
  // setsid: own session, so Jupyter is not killed when this command's process group is cleaned up
  "postStartCommand": "setsid nohup jupyter notebook --no-browser --ServerApp.root_dir=${containerWorkspaceFolder} --IdentityProvider.token='' > /tmp/jupyter.log 2>&1 < /dev/null &"
}
